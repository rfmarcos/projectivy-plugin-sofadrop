<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Updates come from the GitHub releases (no store): the system installer still asks the user -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <queries>
        <package android:name="com.spocky.projengmenu" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/plugin_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/ic_banner"
        android:theme="@style/Theme.Sofadrop">

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".Updater$InstallResultReceiver"
            android:exported="false" />

        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Sofadrop.Preview" />

        <!-- Sofascreen: the wallpapers as Android's screensaver (see Sofascreen.kt) -->
        <service
            android:name=".SofascreenService"
            android:exported="true"
            android:label="@string/screensaver_name"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/sofascreen" />
        </service>

        <!-- Sofascreen started from the settings to try it -->
        <activity
            android:name=".SofascreenActivity"
            android:exported="false"
            android:theme="@style/Theme.Sofadrop.Preview" />


        <service
            android:name=".WallpaperProviderService"
            android:exported="true"
            android:label="@string/plugin_name"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/ic_banner"
            tools:ignore="ExportedService">

            <!-- Mandatory for the plugin to be detected, DO NOT CHANGE -->
            <intent-filter>
                <action android:name="tv.projectivy.plugin.WALLPAPER_PROVIDER" />
            </intent-filter>

            <!-- Api version this plugin is compatible with -->
            <meta-data
                android:name="apiVersion"
                android:value="1" />

            <meta-data
                android:name="uuid"
                android:value="@string/plugin_uuid" />

            <meta-data
                android:name="name"
                android:value="@string/plugin_name" />

            <!-- Plugin activity called by Projectivy to configure it -->
            <meta-data
                android:name="settingsActivity"
                android:value=".SettingsActivity" />

            <!-- Projectivy asks again every 10 minutes (it ignores our update broadcast until then); the plugin itself decides when to regenerate -->
            <meta-data
                android:name="itemsCacheDurationMillis"
                android:value="@integer/items_cache_duration_millis" />

            <!-- TIME_ELAPSED only -->
            <meta-data
                android:name="updateMode"
                android:value="1" />
        </service>

        <!-- Shares the generated wallpapers with Projectivy -->
        <!-- Read-only wallpapers for Projectivy, no per-URI grants (see WallpaperContentProvider) -->
        <provider
            android:name=".WallpaperContentProvider"
            android:authorities="${applicationId}.wallpapers"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>

</manifest>

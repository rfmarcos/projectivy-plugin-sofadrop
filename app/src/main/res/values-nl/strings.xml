    <!-- About -->
    <string name="setting_about_title">Over</string>
    <string name="setting_about_desc">Versie %1$s · steun, broncode en vermeldingen</string>
    <string name="about_version">Versie</string>
    <string name="about_support">Steun het project</string>
    <string name="about_support_desc">Vind je de plug-in fijn, dan kun je me een kop koffie geven op Ko-fi</string>
    <string name="about_support_scan">Scan met je telefoon om de Ko-fi-pagina te openen. Bedankt!</string>
    <string name="about_source">Broncode</string>
    <string name="about_source_scan">Scan met je telefoon om de projectpagina te openen.</string>
    <string name="about_credits">Vermeldingen</string>
    <string name="about_credits_desc">Dit product gebruikt de TMDB API, maar is niet goedgekeurd of gecertificeerd door TMDB. Sofadrop gebruikt Trakt, maar is niet goedgekeurd of gecertificeerd door Trakt. Lijsten en kijkgeschiedenis van Simkl (simkl.com). De namen en logo\'s van Trakt, Simkl en MDBList zijn eigendom van hun eigenaars. Lijsten van MDBList. Achtergronden voor Projectivy Launcher. Scores van MDBList en Trakt. Informatie met dank aan IMDb (imdb.com), gebruikt met toestemming; de namen en logo\'s van IMDb, Rotten Tomatoes, Metacritic, Letterboxd en MyAnimeList zijn eigendom van hun eigenaars.</string>
    <string name="qr_link_hint">Scan de code met je telefoon</string>
    <string name="setting_accounts_title">Accounts</string>
    <string name="accounts_description">Verbind diensten door met je telefoon een QR-code te scannen. Geen enkele is verplicht: de TMDB-lijsten en de scores van TMDB, IMDb en Trakt werken zonder account. Als je de verbinding met een dienst verbreekt, worden ook de lijsten uitgevinkt die hem nodig hebben.</string>
    <string name="accounts_summary">Verbonden: %1$s</string>
    <string name="accounts_none">Optioneel · meer lijsten, scores en kijkgeschiedenis</string>
    <string name="accounts_no_account">Geen account nodig</string>
    <string name="accounts_api_key">Verbonden met een API-sleutel</string>
    <string name="enables_tmdb">TMDB-account: voegt je kijklijst en favorieten toe als lijsten. De lijsten en scores van TMDB werken ook zonder.</string>
    <string name="enables_trakt">Trakt-account: je aanbevelingen en kijklijst als lijsten, en je kijkgeschiedenis voor het label bekeken / bezig en om te verbergen wat je al gezien hebt. De Trakt-score werkt ook zonder.</string>
    <string name="enables_simkl">Simkl-account: je lijsten Plan to watch en Watching, en je kijkgeschiedenis voor het label bekeken / bezig en om te verbergen wat je al gezien hebt.</string>
    <string name="enables_mdblist">MDBList-account: je eigen lijsten, en de scores van Rotten Tomatoes (critici en publiek), Metacritic, Letterboxd en MyAnimeList. Gratis accounts mogen 1.000 verzoeken per dag doen; Sofadrop gebruikt er één per lijst bij elke keer maken.</string>
    <string name="enables_imdb">IMDb-scores zonder MDBList komen uit de officiële dataset van IMDb (ongeveer 9 MB). Die wordt gedownload zodra hij nodig is, daarna elke week opnieuw, en eerder (hoogstens dagelijks) als een nieuwe titel ontbreekt. Druk om hem nu te downloaden.</string>
    <string name="setting_details_title">Achtergronddetails</string>
    <string name="style_title">Stijl</string>
    <string name="style_full">Volledig</string>
    <string name="style_logo">Alleen logo</string>
    <string name="style_backdrop">Alleen afbeelding</string>
    <string name="style_full_desc">Logo, kopregel, samenvatting en voettekst, zoals hieronder ingesteld</string>
    <string name="style_logo_desc">Het logo (of de titel) over de afbeelding, verder niets</string>
    <string name="style_backdrop_desc">Alleen de afbeelding</string>
    <string name="style_hidden">Verborgen bij de stijl %1$s</string>
    <string name="details_description">Hoe elke achtergrond eruitziet: stijl (alles, alleen het logo of alleen de afbeelding), taal, lengte van de samenvatting, cast, wat de voettekst toont (de lijst waar hij uit komt, de streamingdiensten) en de resolutie. Met een kortere samenvatting blijft de tekst vrij van de rijen van de launcher. Kopregel bepaalt wat er onder de titel staat: scores, jaar, speelduur, genres. Taal per onderdeel zet het logo of de samenvatting in een andere taal.</string>

    <string name="header_title">Kopregel</string>
    <string name="header_fit_desc">Past de regel niet, dan vallen eerst de scores boven het minimum weg, daarna wat het meest rechts staat (genres één voor één). Zet vooraan wat je niet wilt kwijtraken: het eerste onderdeel en de scores die altijd getoond worden vallen nooit weg.</string>

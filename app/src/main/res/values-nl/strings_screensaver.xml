    <string name="screensaver_title">Screensaver</string>
    <string name="screensaver_description">Sofascreen toont achtergronden als screensaver van Android, ook zonder Projectivy: dezelfde als Projectivy krijgt, of uit eigen lijsten en met een eigen uiterlijk.</string>

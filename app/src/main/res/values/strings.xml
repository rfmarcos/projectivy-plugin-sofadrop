    <string name="about_credits">Credits</string>
    <string name="about_credits_desc">This product uses the TMDB API but is not endorsed or certified by TMDB. Sofadrop uses Trakt but is not endorsed or certified by Trakt. Lists and watch history from Simkl (simkl.com). Trakt, Simkl and MDBList names and logos belong to their owners. Lists from MDBList. Wallpapers for Projectivy Launcher. Scores from MDBList and Trakt. Information courtesy of IMDb (imdb.com), used with permission; IMDb, Rotten Tomatoes, Metacritic, Letterboxd and MyAnimeList names and logos belong to their owners.</string>
    <string name="qr_link_hint">Scan the code with your phone</string>
    <string name="setting_accounts_title">Accounts</string>
    <string name="accounts_description">Connect services by scanning a QR code with your phone. None is required: TMDB lists and the TMDB, IMDb and Trakt ratings work without an account. Disconnecting a service also unticks the lists that need it.</string>
    <string name="accounts_summary">Connected: %1$s</string>
    <string name="accounts_none">Optional · more lists, ratings and watch history</string>
    <string name="accounts_no_account">No account needed</string>
    <string name="accounts_api_key">Connected with an API key</string>
    <string name="enables_tmdb">TMDB account: adds your watchlist and favourites as lists. TMDB\'s lists and ratings work without it.</string>
    <string name="enables_trakt">Trakt account: your recommendations and watchlist as lists, and your watch history for the watched / watching badge and to hide what you\'ve seen. Trakt\'s rating works without it.</string>
    <string name="enables_simkl">Simkl account: your Plan to watch and Watching lists, and your watch history for the watched / watching badge and to hide what you\'ve seen.</string>
    <string name="enables_mdblist">MDBList account: your own lists, and the Rotten Tomatoes (critics and audience), Metacritic, Letterboxd and MyAnimeList ratings. Free accounts allow 1,000 requests a day; Sofadrop uses one per list each time it generates.</string>
    <string name="enables_imdb">IMDb ratings without MDBList come from IMDb\'s official dataset (about 9 MB). It is downloaded when first needed, again every week, and sooner (at most daily) when a new title is missing. Press to download it now.</string>

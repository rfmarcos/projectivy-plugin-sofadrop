<resources>

    <style name="Theme.Sofadrop" parent="@style/Theme.Leanback">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowBackground">@drawable/settings_background</item>
        <item name="colorPrimary">@color/app_background</item>
        <item name="colorAccent">@color/color_accent</item>
    </style>

    <!-- Settings screen styled like Projectivy's own settings -->
    <style name="Theme.Sofadrop.GuidedStep" parent="@style/Theme.Leanback.GuidedStep">
        <item name="guidedStepBackground">@drawable/settings_background</item>
        <item name="guidedActionsBackground">@color/settings_actions_background</item>
        <item name="guidedActionsBackgroundDark">@color/settings_actions_background_dark</item>
        <item name="guidedActionsElevation">0dp</item>
        <item name="guidedActionsShadowWidth">0dp</item>
        <item name="guidedActionsSelectorDrawable">@drawable/settings_item_selector</item>
        <item name="guidedActionItemIconStyle">@style/Widget.Sofadrop.ActionIcon</item>
        <item name="guidedActionItemCheckmarkStyle">@style/Widget.Sofadrop.Checkmark</item>
        <item name="android:listChoiceIndicatorMultiple">@drawable/indicator_checkbox</item>
        <item name="android:listChoiceIndicatorSingle">@drawable/indicator_radio</item>
        <item name="guidanceTitleStyle">@style/Widget.Sofadrop.GuidanceTitle</item>
        <item name="guidanceDescriptionStyle">@style/Widget.Sofadrop.GuidanceDescription</item>
        <item name="guidanceIconStyle">@style/Widget.Sofadrop.GuidanceIcon</item>
    </style>

    <style name="Widget.Sofadrop.ActionIcon" parent="@style/Widget.Leanback.GuidedActionItemIconStyle">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">20dp</item>
    </style>

    <!-- At the end of the row (see settings_action_item.xml) -->
    <style name="Widget.Sofadrop.Checkmark" parent="@style/Widget.Leanback.GuidedActionItemCheckmarkStyle">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
    </style>

    <!-- Titles in white Nunito, like the icon's wordmark; the accent colour is kept for focus and state -->
    <style name="Widget.Sofadrop.GuidanceTitle" parent="@style/Widget.Leanback.GuidanceTitleStyle">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Widget.Sofadrop.Pill.Accent" parent="">
        <item name="android:background">@drawable/pill_accent</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">#FF0B1A24</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.Sofadrop.GuidanceDescription" parent="@style/Widget.Leanback.GuidanceDescriptionStyle">
        <item name="android:maxLines">14</item>
    </style>

    <style name="Widget.Sofadrop.GuidanceIcon" parent="@style/Widget.Leanback.GuidanceIconStyle">
        <item name="android:layout_width">120dp</item>
    </style>

    <style name="Theme.Sofadrop.QrDialog" parent="@style/Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Sofadrop.Preview" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
